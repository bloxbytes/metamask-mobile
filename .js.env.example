# MetaMask Mobile Environment Variables
# For external contributors - create your own Infura project at https://developer.metamask.io

# Required: Infura Project ID for blockchain connectivity
export MM_INFURA_PROJECT_ID="YOUR_INFURA_PROJECT_ID_HERE"

# Firebase Configuration (Base64 encoded)
# For external contributors: Create a Firebase project and add your config files
# See README.md for instructions on how to generate these
export GOOGLE_SERVICES_B64_ANDROID=""
export GOOGLE_SERVICES_B64_IOS=""

# Build Configuration
# export METAMASK_BUILD_TYPE="main"
# export METAMASK_ENVIRONMENT="local"
